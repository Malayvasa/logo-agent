# ─── Composio ──────────────────────────────────────────────────────────────
# Get from https://app.composio.dev/api-keys
COMPOSIO_API_KEY=
# Shared secret used to HMAC-verify incoming Linear webhooks. Set to any
# random string; the same value is passed to scripts/setup-trigger.ts.
COMPOSIO_WEBHOOK_SECRET=

# ─── Composio connected accounts ──────────────────────────────────────────
# In the Composio dashboard, connect Linear and GitHub. Each connection has
# a `ca_…` id and an "entity" (userId). If both accounts are under the same
# entity, set GITHUB_USER_ID and LINEAR_USER_ID to the same value.
LINEAR_CONNECTED_ACCOUNT=
LINEAR_USER_ID=
GITHUB_CONNECTED_ACCOUNT=
# Optional — defaults to "default" (Composio's standard entity name).
GITHUB_USER_ID=

# ─── Target GitHub repo ────────────────────────────────────────────────────
# The repo PRs are opened against. Logos land at src/assets/<slug>.svg.
LOGO_REPO_OWNER=
LOGO_REPO_NAME=
# Optional — defaults to "main". Set to "master" if your default branch is master.
LOGO_REPO_BRANCH=

# ─── Linear workspace ──────────────────────────────────────────────────────
# Find these in Linear settings or via the Linear API.
LINEAR_TEAM_ID=
# UUID of the Linear project the agent watches. Issues outside this project
# are ignored.
LINEAR_LOGOS_PROJECT_ID=
# UUID of the workflow state issues move to once the PR is open and awaiting
# human review.
LINEAR_IN_REVIEW_STATE_ID=
# Optional — defaults to "Logos". The project name the webhook filters on.
LINEAR_PROJECT_NAME=
# Optional — defaults to "Triage". The state name /api/batch picks up.
LINEAR_TRIAGE_STATE_NAME=

# ─── Vectorizer.ai ─────────────────────────────────────────────────────────
# Paid service. Sign up at https://vectorizer.ai/api and create an API token.
VECTORIZER_API_ID=
VECTORIZER_API_SECRET=

# ─── Admin endpoints ───────────────────────────────────────────────────────
# Required for /api/batch and /api/backfill. Pass as `Authorization: Bearer <key>`.
ADMIN_API_KEY=

# ─── Linear personal API key (optional) ────────────────────────────────────
# Only needed if you want designers to drop image files into Linear comments
# as a rerun trigger. Linear gates uploads.linear.app behind the same auth as
# its GraphQL API. Generate at linear.app/<workspace>/settings/account/security.
LINEAR_API_KEY=
